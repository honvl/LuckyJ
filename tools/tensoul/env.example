# Copy to tmp/tensoul/.env and fill in. Never commit the real file.

# Mahjong Soul access token (a UUID). With the Unity web client it is the
# access_token inside the .lq.Lobby.oauth2Login frame: DevTools > Network > WS
# > the gateway socket > Messages, right after the game finishes loading.
# A fresh page load mints a new one; older ones keep working alongside it.
ACCESS_TOKEN=

# US/EN server: https://mahjongsoul.game.yo-star.com   JP: https://game.mahjongsoul.com
MJS_BASE=https://mahjongsoul.game.yo-star.com

# Optional. Leave unset to take the first gateway from the server's config.json.
# The EN client uses wss://engs.mahjongsoul.com/gateway (route-main) or
# wss://engsbk.mahjongsoul.com/gateway (route-bk).
MJS_GATEWAY=wss://engs.mahjongsoul.com/gateway
MJS_ROUTE_ID=en-2

# Unity client versions. Login error 151 ("game version is outdated") means the
# game updated and MJS_RES_VERSION needs bumping; the value is what the client
# reports as res_version in its telemetry, or the resource version shown in the
# in-game settings. The package version is read from the page when possible.
MJS_RES_VERSION=0.16.259
MJS_PACKAGE_VERSION=4.0.10
